# Copy to .env and adapt the values.
# .env is gitignored — never commit it.

PORT=8080
NODE_ENV=development

# Change to a long random string in production:
SESSION_SECRET=libra-maker-dev-secret-2025

# How long the simulated build takes (ms) when Claude CLI is not available:
BUILD_DELAY_MS=2500

# PostgreSQL connection string.
# When set, the server uses PostgreSQL (persistent data).
# When absent, the server uses the in-memory store (demo data, resets on restart).
#
# Format:
#   postgres://USER:PASSWORD@HOST:PORT/DATABASE
#
# Examples:
#   Local Docker:       DATABASE_URL=postgres://libra:libra@localhost:5432/libramaker
#   Supabase:           DATABASE_URL=postgres://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres
#   Railway:            DATABASE_URL=postgres://postgres:PASSWORD@containers-us-west-xxx.railway.app:5432/railway
#   Neon:               DATABASE_URL=postgres://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
#
# For local Postgres set DATABASE_SSL=false to skip the TLS requirement:
#   DATABASE_SSL=false
DATABASE_URL=

# Set to "false" for local Postgres that has no TLS certificate.
DATABASE_SSL=false

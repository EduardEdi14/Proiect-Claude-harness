BUILD_DELAY_MS=2500
 
# Baza de date comuna Libra Maker
# Ioana (are baza de date local):
#   DATABASE_URL=postgresql://libramaker:libramaker2025@harness-db-1:5432/libramaker
# Colegii (schimba cu IP-ul lui Ioana, port 5433):
#   DATABASE_URL=postgresql://libramaker:libramaker2025@192.168.149.147:5433/libramaker
 
 
# Set to "false" for a local Postgres without TLS (typical for Docker/local installs).
# Rulare locala (npm start) sau conectare cu un client de baze de date.
# 5433 e portul publicat de harness-db-1; pe 5432 asculta Postgres-ul
# instalat nativ pe Windows, care e alt server.
DATABASE_URL=postgresql://libramaker:libramaker2025@localhost:5433/libramaker

DATABASE_SSL=false
 

PORT=8080
NODE_ENV=development

SESSION_SECRET=libra-maker-dev-secret-2025

BUILD_DELAY_MS=2500

# PostgreSQL connection string.
# Fill in the credentials your colleague gave you, then restart the container.
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=

# Set to "false" for a local Postgres without TLS (typical for Docker/local installs).
DATABASE_SSL=false

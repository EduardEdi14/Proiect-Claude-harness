# Build context for backend/node/Dockerfile is harness/.
# Keep out everything the image does not need (node_modules is reinstalled
# inside the image by `npm ci`).
.git
.gitignore
**/node_modules
**/npm-debug.log
**/.env
mockup/
workspaces/
scripts/
# docker/ nu mai e exclus in bloc: backend/skills vine din docker/claude-runner/skills,
# iar agentul isi citeste catalogul de acolo.
docker/claude-runner/Dockerfile
backend/cmd/
backend/internal/
*.md
# ...dar SKILL.md sunt cunostintele agentului, nu documentatie.
!docker/claude-runner/skills/**
Dockerfile
docker-compose*.yml
.dockerignore
